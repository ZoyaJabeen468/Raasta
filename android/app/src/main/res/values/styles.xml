<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process starts (native splash). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_teal</item>
        <item name="android:navigationBarColor">@color/splash_teal</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Theme after Flutter initializes — keep teal so no white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_teal</item>
        <item name="android:statusBarColor">@color/splash_teal</item>
        <item name="android:navigationBarColor">@color/splash_teal</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
